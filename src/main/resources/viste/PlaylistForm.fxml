<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.controller.PlaylistFormController" alignment="CENTER" spacing="15">
<Label text="NUOVA PLAYLIST" style="-fx-font-size:28px; -fx-font-weight:bold;"/>
<TextField fx:id="campoNome" promptText="Nome playlist" prefWidth="400" maxWidth="400"/>
<TextArea fx:id="campoDescrizione" promptText="Nome playlist" prefWidth="400" maxWidth="400" prefHeight="100"/>
<Button text="Salva" onAction="#salva"/>
<Button text="Annulla" onAction="#annulla"/>
<Label fx:id="messaggioLabel" text=""/>
</VBox>
