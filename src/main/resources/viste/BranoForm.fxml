<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?> 
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.controller.BranoController" spacing="10">
<padding>
<Insets top="20" right="25" bottom="20" left="25"/>
</padding>
<Label text="GESTIONE BRANI" style="-fx-font-size: 28px; -fx-font-weight: bold;"/>
<TableView fx:id="tabellaBrani" prefHeight="200">
<columns> 
<TableColumn fx:id="colonnaTitolo" text="Titolo" prefWidth="190"/>
<TableColumn fx:id="colonnaDurata" text="Durata (secondi)" prefWidth="120"/>
<TableColumn fx:id="colonnaGeneri" text="Generi" prefWidth="160"/>
<TableColumn fx:id="colonnaAlbum" text="Album" prefWidth="180"/>
<TableColumn fx:id="colonnaAscolti" text="Ascolti" prefWidth="90"/>
</columns>
</TableView>
<Label text="Dati del brano" style="-fx-font-size:18px; -fx-font-weight: bold;"/>
<VBox spacing="4">
<Label text="Titolo"/>
<TextField fx:id="campoTitolo" promptText="Titolo del brano"/>
</VBox>
<HBox spacing="10">
<VBox spacing="4" HBox.hgrow="ALWAYS">
<Label text="Durata in secondi"/>
<TextField fx:id="campoDurata" promptText="Es. 210"/>
</VBox>
<VBox spacing="4" HBox.hgrow="ALWAYS">
<Label text="Album"/>
<ComboBox fx:id="campoAlbum" promptText="Seleziona album" maxWidth="Infinity"/>
</VBox>
</HBox>
<VBox spacing="4">
<Label text="Generi musicali (separati da virgola)"/>
<TextField fx:id="campoGeneri" promptText="Es. POP, ROCK"/>
</VBox>
<VBox spacing="4">
<Label text="Testo del brano"/>
<TextArea fx:id="campoTesto" promptText="Inserisci il testo del brano" prefRowCount="3" wrapText="true"/>
</VBox>
<HBox spacing="10">
<Button text="Nuovo / Pulisci" onAction="#pulisciCampi"/>
<Button text="Crea brano" onAction="#creaBrano"/>
<Button text="Modifica brano" onAction="#modificaBrano"/>
<Button text="Elimina brano" onAction="#eliminaBrano"/>
</HBox>
<Label fx:id="messaggio" wrapText="true"/>
</VBox>
