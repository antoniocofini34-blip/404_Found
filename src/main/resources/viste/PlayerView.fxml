<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Slider?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<StackPane fx:id="rootPlayer"
  xmlns="http://javafx.com/javafx/21
  xmlns:fx="http://javafx.com/fxml/1
  fx:controller="com.example.controller.PlayerController"
  stylesheets="@../player.css">
  <!-- SFONDO: COPERTINA ESTESA SU TUTTA LA VISTA -->
  <ImageView fx:id="copertinaAlbum"
    managed="false"
    mouseTransparent="true"
    fitWidth="0"
    fitHeight="0"
    preserveRatio="false"
    smooth"true"/>
    <Region fx:id="overlayCopertina"
      mouseTransparent="true"
      minWidth="0"
      minHeight="0"
      maxWidth="Infinity"
      maxHeight="Infinity"
      style="-fx-background-color: rgba(0, 0, 0, 0.62);"/>
      <!-- CONTROLLI IN PRIMO PIANO -->
      <VBox fx:id="contenitoreControlli"
        alignment="TOP_CENTER"
        spacing="12"
        maxWidth="Infinity"
        maxHeight="Infinity">
        <padding> 
          <Insets top="25"
            right="35"
            bottom="25"
            left="35"/>
        </padding>
        <Label fx:id="albumBrano"
          text=""
          maxWidth="Infinity"
          alignment="CENTER"
          style="-fx-font-size: 20px; -fx-font-weight: bold;"/>
        <Region VBox.vgrow="ALWAYS"/>
        <VBox spacing="4"
          alignment="CENTER_LEFT"
          maxWidth="Infinity">
        <Label fx:id="titoloBrano"
          text="Nessun brano in riproduzione"
          maxWidth="Infinity"
          wrapText="true"
          style="-fx-font-size: 36px; -fx-font-weigth: bold;"/>
        <Label fx:id="artistaBrano"
          text=""
          maxWidth="Infinity"
          wrapText="true"
          visible="true"
          managed="true"
          style="-fx-font-size:14px;"/>
        </VBox>
        <!-- BARRA DI AVANZAMENTO -->
        <Slider fx:id="barraAvanzamento"
          min="0"
          max="1"
          value="0"
          prefWidth="600"
          maxWidth="Infinity"
          disable="true"
          onMousePressed="#inizioTrascinamento"
          onMouseReleased="#fineTrascinamento"/>
          <!-- TEMPI -->
          <HBox maxWidth="Infinity"
            alignment="CENTER"
            spacing="0">
          <Label fx:id="tempoTrascorso"
            text="00:00"
            style="-fx-font-size:12px;"/>
          <Region HBox.hgrow="ALWAYS"/>  
            <Label fx:id="tempoRimanente"
              text="-00:00"
              style="-fx-font-size:12px;"/>
          </HBox>
          <HBox spacing="10"
            alignment="CENTER"
            <Button fx:id="bottoneIndietro"
              text="⏮️ Indietro"
              onAction="#indietro"/>
            <Button fx:id="bottonePlay"
              text="▶️ Play"
              onAction="#play"/>
            <Button fx:id="bottonePausa"
              text="⏸️ Pausa"
              onAction="#pausa"/>
            <Button fx:id="bottoneStop" 
              text="⏹️ Stop"
              onAction="#stop"/>
            <Button fx:id="bottoneAvanti"
              text="Avanti ⏭️"
              onAction="#avanti"/>
            </HBox>
            <HBox spacing="10"
              alignment="CENTER">
              <ToggleButton fx:id="bottoneShuffle"
                text="🔀 Shuffle"
                onAction="#shuffle"/>
              <ToggleButton fx:id="bottoneRepeat"
                text="🔁 Repeat"
                onAction="#repeat"/>
              <Button text="♫ Testo"
                onAction="#apriTesto"
                style="-fx-font-size:14px;"/>
              <Button text="Esc"
                onAction="#tornaHome"
                style="-fx-font-size:14px;"/>
              </HBox>
            </VBox>
          </StackPane>
