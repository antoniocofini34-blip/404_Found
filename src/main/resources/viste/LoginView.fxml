<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller:"com.example.controller.LoginController" alignment="CENTER" spacing="12" prefWidth="380" prefHeight="300">
<padding>
<Insets top="25" right="30" bottom="25" left="30"/>
</padding>
<Label text="UnivaqSound-Accesso amministratore" style="-fx-font-size:17px; -fx-font-weight:bold;"/>
<TextField fx:id="campoEmail" promptText="Email amministratore" maxWidth="280"/>
<PasswordField fx:id="campoPassword" promptText="Password" maxWidth="280" onAction="#accedi"/>
<Label fx:id="messaggioErrore" style="-fx-text-fill:red;"/>
<Button text="Accedi" onAction="#accedi" maxWidth="280"/>
<Button text="Annulla" onAction="#annulla" maxWidth="280"/>
</VBox>
