<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<VBox xmlns="http://javafx.com.javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.controller.ArtistaController" spacing="12" fillWidth="true">
<padding> 
<Insets top="20" right="25" bottom="20" left="25"/>
</padding>
<Label text="GESTIONE ARTISTI" style="-fx-font-size:28px; -fx-font-weight: bold;"/>
<TableView fx:id="tabellaArtisti" prefHeight="220">
<columns> 
<TableColumn fx:id="colonnaNome" text="Nome" prefWidth="220"/>
<TableColumn fx:id="colonnaTipo" text="Tipologia" prefWidth="120"/>
<TableColumn fx:id="colonnaGenere" text="Genere principale" prefWidth="200"/>
</columns>
</TableView>
<Label text="Dati dell'artista" style="-fx-font-size:18px; fx-font-weight: bold;"/>
<HBox spacing="10">
<VBox spacing="5" HBox.hgrow="ALWAYS">
<Label text="Tipologia"/>
<ComboBox fx:id="campoTipo" promptText="Scegli tipologia" maxWidth="Infinity"/>
</VBox>
<VBox spacing="5" HBox.hgrow="ALWAYS">  
<Label text="Nome d'arte / nome gruppo"/>
<TextField fx:id="campoNome" promptText="Nome artista"/>
</VBox>
</HBox>
<VBox spacing="5">
<Label text="Biografia"/>
<TextArea fx:id="campoBiografia" promptText="Inserisci la biografia" prefRowCount="3" wrapText="true"/>
</VBox>
<VBox spacing="5">
<Label text="Genere principale"/>
<ComboBox fx:id="campoGenerePrincipale" promptText="Scegli il genere" maxWidth="Infinity"/>
</VBox>
<VBox spacing="5">
<Label text="Generi secondari (separati da virgola)"/>
<TextField fx:id="campoGeneriSecondari" promptText="Esempio: POP, ROCK"/>
</VBox>
<HBox spacing="10">
<Button text="Nuovo / Pulisci" onAction="#pulisciCampi"/>
<Button text="Crea artista" onAction="#creaArtista"/>
<Button text="Modifica artista" onAction="#modificaArtista"/>
<Button text="Elimina artista" onAction="#eliminaArtista"/>
</HBox>
<Label fx:id="messaggio" wrapText="true" style="-fx-font-size: 14px;"/>
</VBox>
