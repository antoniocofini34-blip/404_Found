<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<VBox xmlns="http://javafx.com.javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.controller.ArtistaController" spacing="12" fillWidth="true">
<padding> 
<Insets top="20" right="25" bottom="20" left="25"/>
</padding>
<Label text="GESTIONE ARTISTI" style="-fx-font-size:28px; -fx-font-weight: bold;"/>
<TableView fx:id="tabellaArtisti" prefHeight="180" maxWidth="540">
<columns> 
<TableColumn fx:id="colonnaNome" text="Nome" prefWidth="180" minWidth="100"/>
<TableColumn fx:id="colonnaTipo" text="Tipologia" prefWidth="180" minWidth="100"/>
<TableColumn fx:id="colonnaGenere" text="Genere principale" prefWidth="180" minWidth="100"/>
</columns>
</TableView>
<Label text="Dati dell'artista" style="-fx-font-size:18px; fx-font-weight: bold;"/>
<HBox spacing="10" alignment="BOTTOM_LEFT">
<VBox spacing="5" prefWidth="180">
<Label text="Tipologia"/>
<ComboBox fx:id="campoTipo" promptText="Scegli tipologia" prefWidth="180" maxWidth="180"/>
</VBox>
<VBox fx:id="contenitoreNome" spacing="5" HBox.hgrow="ALWAYS" visible="false" managed="false">
<Label fx:id="etichettaNome" text="Nome d'arte"/>
<TextField fx:id="campoNome" promptText="Inserisci il nome" maxWidth="200"/>
</VBox>
</HBox>
<HBox spacing="15" alignment="TOP_LEFT">
<VBox fx:id="areaComponenti" spacing="8" visible="false" managed="false" prefWidth="490">
<Label text="Componenti della band" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>
<TableView fx:id="tabellaComponenti" prefHeight="220" VBox.vgrow="ALWAYS">
<columns>
<TableColumn fx:id="colonnaNomeComponente" text="Nome" prefWidth"150"/>
<TableColumn fx:id="colonnaCognomeComponente" text="Cognome" prefWidth"160"/>
<TableColumn fx:id="colonnaRuoloComponente" text="Ruolo" prefWidth"180"/>
</columns>
<TableView>
<HBox spacing="10">
<Button fx:id="pulsanteAggiungiComponente" text="Aggiungi componente" onAction="#aggiungiComponente"/>
<Button fx:id="pilsanteRimuoviComponente" text="Aggiungi componente" onAction="#rimuoviComponente"/>
</HBox>
</VBox>
<VBox spacing="5" HBox.hgrow="ALWAYS">  
<Label text="Biografia"/>
<TextArea fx:id="campoBiografia" promptText="Inserisci la biografia" prefRowCount="6" wrapText="true" HBox.hgrow="ALWAYS" VBox.vgrow="ALWAYS"/>
</VBox>
</HBox>
<HBox spacing="15" alignment="TOP_LEFT">
<VBox spacing="5" prefWidth="230">
<Label text="Genere principale"/>
<ComboBox fx:id="campoGenerePrincipale" promptText="Scegli il genere" maxWidth="Infinity"/>
</VBox>
<VBox spacing="5" HBox.hgrow="ALWAYS">
<Label text="Generi secondari (separati da virgola)"/>
<TextField fx:id="campoGeneriSecondari" promptText="Esempio: POP, ROCK"/>
</VBox>
</HBox>
<HBox spacing="10">
<Button text="Nuovo / Pulisci" onAction="#pulisciCampi"/>
<Button text="Crea artista" onAction="#creaArtista"/>
<Button text="Modifica artista" onAction="#modificaArtista"/>
<Button text="Elimina artista" onAction="#eliminaArtista"/>
</HBox>
<Label fx:id="messaggio" wrapText="true" style="-fx-font-size: 14px;"/>
</VBox>
