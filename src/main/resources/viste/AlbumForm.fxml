<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<import javafx.scene.layout.HBox?>
<import javafx.scene.layout.VBox?>
<VBox xmlns="http://javafx.com/javafx/21"
  xmlns:"http://javafx.com/fxml/1"
  fx:controller="com.example.controller.AlbumController"
  spacing="12"
  fillWidth="true">
<padding>
  <Insets top="20"
  right="25"
  bottom="20"
  left="25"/>
</padding>
<Label text="GESTIONE ALBUM" 
  style="-fx-font-size:28px; -fx-font-weight: bold;"/>
<TableView fx:id="tabellaAlbum"
  prefHeight="220">
  <columns>
    <TableColumn fx:id="colonnaTitolo"
      text="Titolo"
      prefWidth="230"/>
    <TableColumn fx:id="colonnaAnno"
      text="Anno"
      prefWidth="100"/>
    <TableColumn fx:id="colonnaArtista"
      text="Artista"
      prefWidth="200"/>
  </columns>
</TableView>
<Label text="Dati dell'album"
  style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
<VBox spacing="5">
  <Label text="Titolo"/>
  <LTextField fx:id"campoTitolo"
    promptText="Titolo dell'album"/>
</VBox>
<HBox spacing="10">
  <VBox spacing="5"
    HBox.hgrow="ALWAYS">
  <Label text="Anno di pubblicazione"/>
  <TextField fx:id="campoAnno"
    promptText="Es. 2026"/>
  </VBox>
  <VBox spacing="5"
    HBox.hgrow="ALWAYS">
   <Label text="Artista"/> 
   <ComboBox fx:id="campoArtista"
     promptText="Seleziona artista"
     maxWidth="Infinity"/>
  </VBox>
</HBox>
<VBox spacing="5">
  <Label text="Generi musicali (separati da virgola)"/>
  <TextField fx:id="campoGeneri"
    promptText="Es. POP, ROCK"/>
</VBox>
<VBox spacing="5">
  <Label text="Percorso o nome della copertina (facoltativo)"/>
  <TextField fx:id="campoCopertina"
    promptText="Es. copertina.jpg"/>
</VBox>
<HBox spacing="10">
  <Button text="Nuovo / Pulisci"
    onAction="#pulisciCampi"/>
  <Button text="Crea album"
    onAction="#creaAlbum"/>
  <Button text="Modifica album"
    onAction="#modificaAlbum"/>
  <Button text="Elimina album"
    onAction="#eliminaAlbum"/>
</HBox>
<Label fx:id="messaggio" 
  wrapText="true"
  style="-fx-font-size:14px;"/>
<VBox>
